{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(uv run python tasks.py test*)",
      "Bash(uv run python tasks.py run*)",
      "Bash(uv run python tasks.py check*)",
      "Bash(uv run python tasks.py acceptance*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "PowerShell(uv run python tasks.py test*)",
      "PowerShell(uv run python tasks.py run*)",
      "PowerShell(uv run python tasks.py check*)",
      "PowerShell(uv run python tasks.py acceptance*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)"
    ],
    "deny": [
      "Bash(uv run python tasks.py deliver*)",
      "PowerShell(uv run python tasks.py deliver*)",
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(rm -rf*)",
      "PowerShell(git push*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git rebase*)",
      "PowerShell(rm -rf*)",
      "PowerShell(Remove-Item -Recurse*)",
      "Read(./.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_inputs.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/require_acceptance.py\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
